# ── Server Config ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database Config (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=secret
DB_NAME=soccer_db

# ── Authentication ────────────────────────────────────────────────────────────
# Recomendado: openssl rand -base64 32
JWT_SECRET=tu_secreto_super_seguro_shhh
JWT_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
# Ruta donde se almacenarán las imágenes de jugadores, noticias, etc.
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880 # 5MB en bytes
